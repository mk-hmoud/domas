# Database Connection
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=domas

# Database Setup Secrets
APP_USER=app_user
APP_USER_PASSWORD=123

# Server Config
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Object Storage (MinIO / S3-compatible)
# Leave STORAGE_ENDPOINT empty for AWS S3; set to MinIO URL for self-hosted
STORAGE_ENDPOINT=http://localhost:9000
# Public URL browsers use to load pre-signed image URLs (often same as STORAGE_ENDPOINT in dev)
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=domas-files

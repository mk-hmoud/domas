{
  "extends": "@domas/tsconfig/vite.json",
  "compilerOptions": {
    "baseUrl": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@domas/ui": ["../../packages/ui/src"],
      "@domas/ts-types": ["../../packages/ts-types/src"],
      "@domas/api-client": ["../../packages/api-client/src"]
    },

    "types": ["vite/client"],
    "noEmit": true,

    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"]
}
